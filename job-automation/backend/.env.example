# ============================================================
# JobPilot Backend — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL via Docker) ---
DATABASE_URL="postgresql://jobpilot:jobpilot@localhost:5433/jobpilot?schema=public"

# --- AI (Gemini) ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Supabase Storage (resume PDF backup) ---
# Create a project at supabase.com, then: Project Settings → API
# Use the service_role key for server-side uploads (bypasses RLS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-supabase-key-here
SUPABASE_RESUME_BUCKET=resumes

# --- Email (Gmail SMTP for sending applications) ---
# Enable 2FA → Google Account → Security → App Passwords → Create
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Redis (BullMQ queue — via Docker, no extra config needed) ---
REDIS_URL=redis://localhost:6379

# --- API Protection (random string for local use) ---
API_KEY=change-this-to-a-random-secret

# --- Auth / JWT (sign session cookies) ---
# 32+ bytes; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-chars
